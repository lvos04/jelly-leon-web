# jelly-leon-web — build-variabelen (alleen voor ontwikkeling/CI; er zijn geen runtime-variabelen en geen geheimen).
# De webclient wordt meegebouwd in de image ghcr.io/lvos04/jelly-leon (ADR-0008); deze waarden zijn nooit verplicht.

# Bouwlabel dat in de bundel komt (__JF_BUILD_VERSION__). CI zet hier de commit-SHA; leeg = "Release".
JELLYFIN_VERSION=

# 1 = systeemlettertypen gebruiken i.p.v. de meegeleverde Noto-fonts (__USE_SYSTEM_FONTS__). Standaard 0.
USE_SYSTEM_FONTS=0

# Wordt door webpack-devserver zelf gezet (npm start); niet handmatig invullen.
# WEBPACK_SERVE=

# production voor npm run build:production (zet het script zelf via cross-env).
# NODE_ENV=production

# Alleen voor de web-client-smoketest (tools/jelly-leon-web/e2e/web_smoke.py), optioneel:
# pad naar een Chromium-binary als Playwright zijn eigen browser niet kan gebruiken.
# JLW_CHROMIUM=
# map met vooraf geïnstalleerde Playwright-browsers.
# PLAYWRIGHT_BROWSERS_PATH=
